# Netlify va Cloudflare Pages uchun
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://get.geojs.io https://ipwho.is; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=604800
/css/*
  Cache-Control: public, max-age=604800
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
